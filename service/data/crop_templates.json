  "creditRules": [
   {
    "id": "cr-risk-high-before-installment",
    "name": "High risk before an installment",
    "enabled": true,
    "when": {
     "metric": "risk.tier",
     "op": "gte",
     "value": "high",
     "withinDaysBeforeInstallment": 60,
     "and": null
    },
    "then": "watch",
    "message": "High climate risk within 60 days of an installment: review repayment capacity."
   },
   {
    "id": "cr-abandonment",
    "name": "Abandonment signal",
    "enabled": true,
    "when": {
     "metric": "imagery.abandonment",
     "op": "eq",
     "value": true,
     "withinDaysBeforeInstallment": null,
     "and": null
    },
    "then": "field_visit",
    "message": "Vigour lost in the dry season against its own history and its peers: schedule a field visit."
   },
   {
    "id": "cr-decree-low-snowmelt",
    "name": "Water decree and low snowmelt",
    "enabled": true,
    "when": {
     "metric": "water.decreeActive",
     "op": "eq",
     "value": true,
     "withinDaysBeforeInstallment": null,
     "and": [
      {
       "metric": "water.snowmeltPct",
       "op": "lt",
       "value": 70,
       "withinDaysBeforeInstallment": null
      }
     ]
    },
    "then": "watch",
    "message": "Water-scarcity decree active and snowmelt below 70 % of normal: irrigation supply at risk."
   },
   {
    "id": "cr-burned-area",
    "name": "Burned area on the orchard",
    "enabled": true,
    "when": {
     "metric": "events.burnedAreaIntersects",
     "op": "eq",
     "value": true,
     "withinDaysBeforeInstallment": null,
     "and": null
    },
    "then": "restructure_review",
    "message": "A mapped burned area intersects the orchard: asset damage likely, open a restructuring review."
   }
  ],
  "sources": [
   "FAO Frost Protection Vol. 1 (2005), Tables 4.7–4.9, after Proebsting & Mills (1978): critical temperatures T10/T90",
   "FAO-56 (Allen et al. 1998), Table 12: crop coefficients Kc",
   "Agroseguros subsidised policy sheets distributed by INDAP (2016–2022): frost and 'lluvia mayor' definitions",
   "ADR-0013 D5: approximate central-Chile stage calendar (not verified against an INIA document)",
   "Chill requirement: trade/INIA-derived ranges (Lapins 400–500 h, Santina 600–800 h)",
   "FAO-56 Table 12, apple/cherry/pear without ground cover, frost: Kc ini 0.45, mid 0.95, end 0.70 (families/chile-crops-perils)",
   "Stage windows, sensitivities and thresholds are expert defaults reviewed against families/chile-crops-perils (2026-11-07); approximate, editable per portfolio crop, zone and farm",
   "Cherry cracking: ~10 mm of rain is harmless, ~50 mm during harvest causes serious damage; 3-day sums of 20 mm (severity 0.5) to 30 mm (1.0) in the harvest window (families/chile-crops-perils)"
  ],
  "approximate": true
